# Get from https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional — see https://openrouter.ai/models
VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Get from https://myprojects.geoapify.com/
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Get from https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# After configuring Supabase, run supabase/schema.sql in the SQL editor
